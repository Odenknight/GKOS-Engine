{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Odenknight/gkos-standard/schemas/provisional/science/environment-snapshot.draft.schema.json",
  "title": "SRTP Environment Snapshot — PROVISIONAL DRAFT, informative only",
  "allOf": [
    { "$ref": "research-object.draft.schema.json" },
    {
      "type": "object",
      "required": ["snapshot_digest", "runtime", "dependencies", "platform"],
      "properties": {
        "srtp_type": { "const": "srtp:EnvironmentSnapshot" },
        "snapshot_digest": { "$ref": "../../gkx-common.defs.json#/$defs/contentHash" },
        "runtime": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "type": "object", "required": ["name", "version", "digest"], "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "digest": { "$ref": "../../gkx-common.defs.json#/$defs/contentHash" } }, "additionalProperties": true } },
        "platform": { "type": "object", "required": ["os", "architecture"], "properties": { "os": { "type": "string" }, "architecture": { "type": "string" }, "container_digest": { "$ref": "../../gkx-common.defs.json#/$defs/contentHash" } }, "additionalProperties": true }
      },
      "additionalProperties": true
    }
  ]
}
