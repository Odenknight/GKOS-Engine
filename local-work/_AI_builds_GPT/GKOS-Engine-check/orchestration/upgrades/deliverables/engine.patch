diff --git a/.github/workflows/runtime-qualification.yml b/.github/workflows/runtime-qualification.yml
new file mode 100644
index 0000000..08bad07
--- /dev/null
+++ b/.github/workflows/runtime-qualification.yml
@@ -0,0 +1,71 @@
+name: Historical and current runtime qualification
+
+on:
+  push:
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  historical-contract-replay:
+    runs-on: ${{ matrix.os }}
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-24.04, windows-latest, macos-14]
+        node: [22, 23, 24]
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
+        with:
+          path: candidate
+          fetch-depth: 0
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
+        with:
+          path: historical
+          ref: 97ae3560a4fa2e771b60fa63d6dc0349d0b4c864
+          fetch-depth: 0
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
+        with:
+          node-version: ${{ matrix.node }}
+          cache: npm
+          cache-dependency-path: historical/package-lock.json
+      - name: Install exact historical dependencies
+        working-directory: historical
+        run: npm ci --ignore-scripts
+      - name: Replay unchanged historical assertions and record actual commands
+        shell: bash
+        run: node candidate/scripts/runtime-qualification.mjs --historical-checkout historical --output "$RUNNER_TEMP/historical-receipt"
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        if: always()
+        with:
+          name: historical-contract-${{ matrix.os }}-node-${{ matrix.node }}
+          path: ${{ runner.temp }}/historical-receipt/
+          if-no-files-found: error
+
+  current-runtime:
+    needs: historical-contract-replay
+    runs-on: ubuntu-24.04
+    strategy:
+      fail-fast: false
+      matrix:
+        node: [22, 23, 24]
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
+        with:
+          fetch-depth: 0
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
+        with:
+          node-version: ${{ matrix.node }}
+          cache: npm
+      - run: npm ci --ignore-scripts
+      - name: Current runtime qualification (source inventory and executed tests)
+        run: node scripts/runtime-qualification.mjs --output "$RUNNER_TEMP/current-runtime-receipt"
+      - name: Upload evidence even when qualification fails
+        if: always()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        with:
+          name: current-runtime-node-${{ matrix.node }}
+          path: ${{ runner.temp }}/current-runtime-receipt/
+          if-no-files-found: error
