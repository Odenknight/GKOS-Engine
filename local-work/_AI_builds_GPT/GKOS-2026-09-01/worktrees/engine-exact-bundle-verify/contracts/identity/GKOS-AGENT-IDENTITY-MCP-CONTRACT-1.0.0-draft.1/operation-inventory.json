  "reference_lifecycle": {
    "capacity": "2048 live references per session and 32768 per process/vault; issuance beyond either cap returns GKOS_P6_CONCURRENCY_LIMIT",
    "durable_authorization_evidence": "the existing page_snapshot row binds operation/filter/order, issued_reference_count and issued_reference_set_digest; request, policy_decision and activity rows bind each subsequent resolution by input digest and outcome; no seventeenth record type is introduced",
    "graph_temporal_read": "requires a non-null live same-session scope_ref plus at, state, cursor and limit; canonical decode/re-encode and scope_ref.resolve precede policy and physical qualification; filter/snapshot bind scope_ref digest, session_id, agent_id, auth_epoch, authority_generation, policy_decision_id, physical identity, at, state and ordering; only record_ref values inside that resolved scope may be issued; it can never bootstrap a scope",
    "invalidation": "all refs expire at the earliest of 900000 ms, page snapshot expiry, session close/expiry/stale, auth_epoch change, authority_generation change, process restart or write-gate closure",
    "issuance": "navigation.discover with scope_ref null and cursor null is the only initial issuance path: after current policy and physical-root qualification it returns authorized root scope_ref, record_ref and child scope_ref values; later pages/calls may reuse only a same-session issued scope_ref; capability.list_effective issues no references",
    "lifetime_ms": 900000,
    "private_dependency_rule": "every operation that returns a newly minted record_ref declares record_ref.issue; every operation that scans or discovers physical records also declares record_ref.discover before issue; record_ref.resolve is distinct and required for caller-supplied refs",
    "resolution_errors": "malformed ref is GKOS_P6_INVALID_PARAMS; unknown/expired/wrong-session/wrong-agent ref is authenticated-redacted GKOS_P6_RESOURCE_NOT_FOUND; generation or auth-epoch mismatch is GKOS_P6_REQUEST_STALE_AUTHORITY",
    "runtime_registry": "the resolver mapping is process-memory-only and binds ref type, physical no-follow handle identity, canonical locator digest, session_id, agent_id, auth_epoch, authority_generation, policy_decision_id, capability, filter_digest, issued_at and expires_at; no raw path enters SQLite, logs, activity or protocol results",
    "wire": "record_ref is gkrec1_ plus 22 base64url characters; scope_ref is gkscp1_ plus 22 base64url characters; each suffix is 128 CSPRNG bits encoded without padding"
  }
}
