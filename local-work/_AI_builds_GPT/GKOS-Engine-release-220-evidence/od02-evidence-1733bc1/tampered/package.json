{
  "name": "gkos-engine",
  "version": "2.1.1",
  "description": "Deterministic GKX validation, projection, graph, and source-content-read-only Navigation with explicit governance boundaries.",
  "type": "module",
  "main": "./dist/gkos-engine.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/gkos-engine.mjs",
      "default": "./dist/gkos-engine.mjs"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.mjs",
      "default": "./dist/adapter.mjs"
    },
    "./gkx": {
      "types": "./dist/gkx.d.ts",
      "import": "./dist/gkx.mjs",
      "default": "./dist/gkx.mjs"
    },
    "./graphiti": {
      "types": "./dist/graphiti-adapter.d.ts",
      "import": "./dist/graphiti-adapter.mjs",
      "default": "./dist/graphiti-adapter.mjs"
    },
    "./navigation": {
      "types": "./dist/navigation/index.d.ts",
      "import": "./dist/navigation.mjs",
      "default": "./dist/navigation.mjs"
    },
    "./governance": {
      "types": "./dist/governance/index.d.ts",
      "import": "./dist/governance.mjs",
      "default": "./dist/governance.mjs"
    }
  },
  "bin": {
    "gkx": "bin/gkx.mjs"
  },
  "files": [
    "dist/",
    "!dist/gkos-agent-*",
    "!dist/sea-config.json",
    "!dist/sea-prep.blob",
    "bin/",
    "src/",
    "contracts/",
    "docs/",
    "evidence/ENGINE-NAV-CONTRACT-1.0.0.json",
    "evidence/2026-08-16-navigation-2.1.0-verification.md",
    "README.md",
    "TECHNICAL_README.md",
    "BEGINNERS_GUIDE.md",
    "COMPAT.md",
    "CHANGELOG.md",
    "TRACEABILITY.md",
    "services/gkos-intelligence/",
    "!services/gkos-intelligence/**/__pycache__/**",
    "!services/gkos-intelligence/**/*.pyc",
    "!services/gkos-intelligence/**/*.pyo"
  ],
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "pretest:navigation": "node scripts/build.mjs",
    "test:navigation": "node --test test/governance.test.mjs test/navigation.test.mjs test/navigation-determinism.test.mjs test/navigation-architecture.test.mjs test/navigation-cli.test.mjs test/public-api.test.mjs",
    "test:intelligence": "python -m pytest services/gkos-intelligence",
    "pack:check": "node scripts/check-pack.mjs",
    "check:license": "node scripts/check-license.mjs"
  },
  "license": "Apache-2.0",
  "author": "OdenKnight",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Odenknight/GKOS-Engine.git"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6",
    "typescript": "5.9.3"
  }
}
