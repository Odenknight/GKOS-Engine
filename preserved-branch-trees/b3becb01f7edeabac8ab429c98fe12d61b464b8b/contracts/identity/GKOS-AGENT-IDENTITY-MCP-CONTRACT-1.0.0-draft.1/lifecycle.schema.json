{
  "$id": "lifecycle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entity": {
      "enum": [
        "agent",
        "credential",
        "session",
        "authority"
      ]
    },
    "event": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "from": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "generation": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "pattern": "^(?:19(?:7[0-9]|[89][0-9])|[2-9][0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "type": "string"
    },
    "to": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "entity",
    "from",
    "event",
    "to",
    "generation",
    "occurred_at"
  ],
  "title": "Lifecycle transition",
  "type": "object"
}
