{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Odenknight/gkos-standard/schemas/provisional/science/rerun-comparison.draft.schema.json",
  "title": "SRTP Rerun Comparison — PROVISIONAL DRAFT, informative only",
  "allOf": [
    { "$ref": "research-object.draft.schema.json" },
    {
      "type": "object",
      "required": ["baseline_run_id", "rerun_id", "comparison_mode", "intended_equivalent_inputs", "evaluation", "difference_digest"],
      "properties": {
        "srtp_type": { "const": "srtp:RerunComparison" },
        "baseline_run_id": { "$ref": "../../gkx-common.defs.json#/$defs/relationshipTarget" },
        "rerun_id": { "$ref": "../../gkx-common.defs.json#/$defs/relationshipTarget" },
        "comparison_mode": { "type": "string", "enum": ["byte-identity", "numerical-tolerance", "semantic-agreement", "expected-nondeterminism"] },
        "intended_equivalent_inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "tolerance": { "type": "object", "properties": { "absolute": { "type": "number", "minimum": 0 }, "relative": { "type": "number", "minimum": 0 }, "units": { "type": "string" } }, "additionalProperties": true },
        "evaluation": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "UNEVALUATED"] },
        "difference_digest": { "$ref": "../../gkx-common.defs.json#/$defs/contentHash" },
        "profile_evaluated": { "type": "string" }
      },
      "if": { "properties": { "comparison_mode": { "const": "numerical-tolerance" } } },
      "then": {
        "required": ["tolerance"],
        "properties": {
          "tolerance": { "anyOf": [{ "required": ["absolute"] }, { "required": ["relative"] }] }
        }
      },
      "additionalProperties": true
    }
  ]
}
