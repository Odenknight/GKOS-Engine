{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Odenknight/gkos-standard/schemas/provisional/science/execution-manifest.draft.schema.json",
  "title": "SRTP Execution Manifest — PROVISIONAL DRAFT, informative only",
  "allOf": [
    { "$ref": "research-object.draft.schema.json" },
    {
      "type": "object",
      "required": ["request_id", "code_digest", "dataset_digests", "environment_digest", "parameters_digest", "started_at", "state", "event_ids"],
      "properties": {
        "srtp_type": { "const": "srtp:ExecutionManifest" },
        "request_id": { "$ref": "../../gkx-common.defs.json#/$defs/relationshipTarget" },
        "code_digest": { "$ref": "../../gkx-common.defs.json#/$defs/contentHash" },
        "dataset_digests": { "type": "array", "minItems": 1, "items": { "$ref": "../../gkx-common.defs.json#/$defs/contentHash" } },
        "environment_digest": { "$ref": "../../gkx-common.defs.json#/$defs/contentHash" },
        "parameters_digest": { "$ref": "../../gkx-common.defs.json#/$defs/contentHash" },
        "seed": { "type": ["integer", "string", "null"] },
        "started_at": { "$ref": "../../gkx-common.defs.json#/$defs/timestamp" },
        "ended_at": { "$ref": "../../gkx-common.defs.json#/$defs/timestamp" },
        "state": { "type": "string", "enum": ["running", "succeeded", "failed", "partial", "interrupted", "cancelled", "terminated", "recovered"] },
        "recovery_of": { "$ref": "../../gkx-common.defs.json#/$defs/relationshipTarget" },
        "event_ids": { "type": "array", "minItems": 1, "items": { "$ref": "../../gkx-common.defs.json#/$defs/relationshipTarget" } }
      },
      "additionalProperties": true
    }
  ]
}
