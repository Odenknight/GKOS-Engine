{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gkos.example/contracts/navigation-effects/1.0.0/archive-manifest.schema.json",
  "title": "MOC Effect Archive Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactKind", "effectsContract", "effects"],
  "properties": {
    "artifactKind": { "const": "engine.moc-effect-archive-manifest" },
    "effectsContract": { "const": "1.0.0" },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effectId", "planDigest", "targetPath", "beforeDigest", "proposedDigest", "sourceSnapshotDigest", "corpusDigest", "configDigest", "policyDigest", "authorityDigest"],
        "properties": {
          "effectId": { "type": "string", "pattern": "^effect:(?:[0-9a-f]{32}|rollback:[0-9a-f]{32})$" },
          "planDigest": { "$ref": "#/$defs/digest" },
          "targetPath": { "type": "string", "minLength": 1 },
          "beforeDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
          "proposedDigest": { "$ref": "#/$defs/digest" },
          "sourceSnapshotDigest": { "$ref": "#/$defs/digest" },
          "corpusDigest": { "$ref": "#/$defs/digest" },
          "configDigest": { "$ref": "#/$defs/digest" },
          "policyDigest": { "$ref": "#/$defs/digest" },
          "authorityDigest": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
