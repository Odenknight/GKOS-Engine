{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gkos.dev/contracts/admission-policy/1.0.0/policy.schema.json",
  "title": "GKOS generic admission-policy bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "contract", "contractVersion", "policyId", "policyVersion",
    "provider", "engine", "schemaHashes", "reasonCodesHash", "semanticRulesHash",
    "dependencyClosure", "priorityTriggerCodes", "humanReviewTriggerCodes", "autoAllowlist"
  ],
  "properties": {
    "schema": { "const": "gkos.admission-policy.policy.v1" },
    "contract": { "const": "gkos.admission-policy.v1" },
    "contractVersion": { "const": "1.0.0" },
    "policyId": { "$ref": "#/$defs/token" },
    "policyVersion": { "$ref": "#/$defs/token" },
    "provider": { "$ref": "#/$defs/identity" },
    "engine": { "$ref": "#/$defs/engine" },
    "schemaHashes": { "$ref": "#/$defs/schemaHashes" },
    "reasonCodesHash": { "$ref": "#/$defs/sha256" },
    "semanticRulesHash": {
      "const": "sha256:e191a663d29dd2e7f41a1e6b2881ddf4a01190498c980346799209e861246aae"
    },
    "dependencyClosure": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identity" }
    },
    "priorityTriggerCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "humanReviewTriggerCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "autoAllowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "version": { "$ref": "#/$defs/token" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "commit"],
      "properties": {
        "name": { "$ref": "#/$defs/token" },
        "version": { "$ref": "#/$defs/token" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "schemaHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "policy", "decisionReceipt"],
      "properties": {
        "request": { "$ref": "#/$defs/sha256" },
        "policy": { "$ref": "#/$defs/sha256" },
        "decisionReceipt": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
