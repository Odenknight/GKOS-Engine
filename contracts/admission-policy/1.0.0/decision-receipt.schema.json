{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gkos.dev/contracts/admission-policy/1.0.0/decision-receipt.schema.json",
  "title": "GKOS generic admission-policy decision receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "contract", "contractVersion", "requestId", "idempotencyKey", "subjectId",
    "provider", "engine", "schemaHashes", "reasonCodesHash", "semanticRulesHash", "policy",
    "dependencyClosureHash", "requestHash", "inputHashes", "reviewerAssessmentHash",
    "reviewerRecommendedLane", "stage", "outcome", "reasonCodes", "triggerCodes",
    "validationIssues", "authorityState", "materializationAuthorized", "decisionReceiptHash"
  ],
  "properties": {
    "schema": { "const": "gkos.admission-policy.decision-receipt.v1" },
    "contract": { "const": "gkos.admission-policy.v1" },
    "contractVersion": { "const": "1.0.0" },
    "requestId": { "$ref": "#/$defs/nullableToken" },
    "idempotencyKey": { "$ref": "#/$defs/nullableToken" },
    "subjectId": { "$ref": "#/$defs/nullableToken" },
    "provider": { "$ref": "#/$defs/identity" },
    "engine": { "$ref": "#/$defs/engine" },
    "schemaHashes": { "$ref": "#/$defs/schemaHashes" },
    "reasonCodesHash": { "$ref": "#/$defs/sha256" },
    "semanticRulesHash": {
      "const": "sha256:e191a663d29dd2e7f41a1e6b2881ddf4a01190498c980346799209e861246aae"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "version": { "$ref": "#/$defs/token" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "dependencyClosureHash": { "$ref": "#/$defs/sha256" },
    "requestHash": { "$ref": "#/$defs/sha256" },
    "inputHashes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/namedHash" } },
    "reviewerAssessmentHash": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "reviewerRecommendedLane": {
      "oneOf": [
        { "enum": ["AUTO_ADMIT_CANDIDATE", "HUMAN_REVIEW", "PRIORITY_HUMAN_REVIEW"] },
        { "type": "null" }
      ]
    },
    "stage": { "enum": ["PRE_ADJUDICATION", "ADJUDICATION"] },
    "outcome": {
      "enum": ["AUTO_ADMIT_DERIVED", "HUMAN_REVIEW", "PRIORITY_HUMAN_REVIEW", "REVIEW_INVALID"]
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reasonCode" }
    },
    "triggerCodes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
    "validationIssues": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "authorityState": { "const": "NONE" },
    "materializationAuthorized": { "const": false },
    "decisionReceiptHash": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "REVIEW_INVALID" } }, "required": ["outcome"] },
      "then": {
        "properties": {
          "stage": { "const": "PRE_ADJUDICATION" },
          "reasonCodes": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "$ref": "#/$defs/invalidReasonCode" }
          }
        }
      },
      "else": { "properties": { "stage": { "const": "ADJUDICATION" } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "AUTO_ADMIT_DERIVED" } }, "required": ["outcome"] },
      "then": {
        "properties": {
          "reasonCodes": { "const": ["AUTO_ALLOWLIST_MATCH"] },
          "triggerCodes": { "type": "array", "maxItems": 0 },
          "validationIssues": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "PRIORITY_HUMAN_REVIEW" } }, "required": ["outcome"] },
      "then": {
        "properties": {
          "reasonCodes": { "const": ["PRIORITY_TRIGGER"] },
          "triggerCodes": { "type": "array", "minItems": 1 },
          "validationIssues": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "HUMAN_REVIEW" } }, "required": ["outcome"] },
      "then": {
        "properties": {
          "reasonCodes": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "$ref": "#/$defs/humanReasonCode" }
          },
          "validationIssues": { "type": "array", "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "token": {
      "type": "string", "minLength": 1, "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$"
    },
    "nullableToken": { "oneOf": [{ "$ref": "#/$defs/token" }, { "type": "null" }] },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "version": { "$ref": "#/$defs/token" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "engine": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "commit"],
      "properties": {
        "name": { "$ref": "#/$defs/token" },
        "version": { "$ref": "#/$defs/token" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "schemaHashes": {
      "type": "object", "additionalProperties": false,
      "required": ["request", "policy", "decisionReceipt"],
      "properties": {
        "request": { "$ref": "#/$defs/sha256" },
        "policy": { "$ref": "#/$defs/sha256" },
        "decisionReceipt": { "$ref": "#/$defs/sha256" }
      }
    },
    "namedHash": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": { "$ref": "#/$defs/token" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "reasonCode": {
      "enum": [
        "INVALID_REQUEST_SCHEMA", "CONTRACT_BINDING_MISMATCH", "POLICY_BINDING_MISMATCH",
        "VALIDITY_GATE_FAILED", "UNKNOWN_TRIGGER_CODE", "PRIORITY_TRIGGER", "HUMAN_REVIEW_TRIGGER",
        "ARTIFACT_TYPE_NOT_ALLOWED", "REVIEWER_INDEPENDENCE_FAILED", "REVIEWER_CHECK_CONFLICT",
        "UNSUPPORTED_CLAIMS_PRESENT", "CONTRADICTION_PRESENT", "SCOPE_MISMATCH",
        "NOT_REVERSIBLE", "NOT_RECONSTRUCTABLE", "AUTO_ALLOWLIST_MATCH"
      ]
    },
    "invalidReasonCode": {
      "enum": [
        "INVALID_REQUEST_SCHEMA", "CONTRACT_BINDING_MISMATCH", "POLICY_BINDING_MISMATCH",
        "VALIDITY_GATE_FAILED", "UNKNOWN_TRIGGER_CODE"
      ]
    },
    "humanReasonCode": {
      "enum": [
        "HUMAN_REVIEW_TRIGGER", "ARTIFACT_TYPE_NOT_ALLOWED", "REVIEWER_INDEPENDENCE_FAILED",
        "REVIEWER_CHECK_CONFLICT", "UNSUPPORTED_CLAIMS_PRESENT", "CONTRADICTION_PRESENT",
        "SCOPE_MISMATCH", "NOT_REVERSIBLE", "NOT_RECONSTRUCTABLE"
      ]
    }
  }
}
