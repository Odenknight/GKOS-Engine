{
  "$id": "agent-identity.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "auth_epoch": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "authority_generation": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "authority_instance_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "authority_role": {
      "enum": [
        "owner",
        "agent"
      ]
    },
    "contract_version": {
      "const": "1.0.0-draft.1"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^(?:19(?:7[0-9]|[89][0-9])|[2-9][0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "type": "string"
    },
    "disable_reason": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "disabled_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^(?:19(?:7[0-9]|[89][0-9])|[2-9][0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "display_name": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "record_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "restore_epoch": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "status": {
      "enum": [
        "active",
        "disabled"
      ]
    },
    "updated_at": {
      "format": "date-time",
      "pattern": "^(?:19(?:7[0-9]|[89][0-9])|[2-9][0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "type": "string"
    },
    "vault_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "vault_id",
    "authority_instance_id",
    "restore_epoch",
    "agent_id",
    "authority_role",
    "display_name",
    "status",
    "authority_generation",
    "auth_epoch",
    "created_at",
    "updated_at",
    "disabled_at",
    "disable_reason",
    "record_digest"
  ],
  "title": "agent_identity",
  "type": "object"
}
