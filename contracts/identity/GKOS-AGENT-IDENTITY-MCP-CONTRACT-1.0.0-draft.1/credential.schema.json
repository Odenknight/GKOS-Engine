{
  "$id": "credential.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "auth_epoch_issued": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "auth_epoch_revoked": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_generation_issued": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "authority_generation_revoked": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_instance_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "contract_version": {
      "const": "1.0.0-draft.1"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^(?:19[7-9][0-9]|2[0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "type": "string"
    },
    "credential_generation": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "credential_id": {
      "maxLength": 31,
      "minLength": 31,
      "pattern": "^gkc(?:0|1)_[a-z2-7]{26}$",
      "type": "string"
    },
    "credential_role": {
      "enum": [
        "owner_admin",
        "agent"
      ]
    },
    "digest_algorithm": {
      "enum": [
        "sha256-domain-separated",
        "legacy-sha256-domain-separated"
      ]
    },
    "format": {
      "enum": [
        "gkos1",
        "legacy-hex-v0"
      ]
    },
    "record_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "replaces_credential_id": {
      "anyOf": [
        {
          "maxLength": 31,
          "minLength": 31,
          "pattern": "^gkc(?:0|1)_[a-z2-7]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "restore_epoch": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "revocation_reason": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "revoked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^(?:19[7-9][0-9]|2[0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "secret_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "revoked"
      ]
    },
    "vault_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "vault_id",
    "authority_instance_id",
    "restore_epoch",
    "credential_id",
    "agent_id",
    "credential_role",
    "format",
    "digest_algorithm",
    "secret_digest",
    "status",
    "credential_generation",
    "authority_generation_issued",
    "auth_epoch_issued",
    "authority_generation_revoked",
    "auth_epoch_revoked",
    "revoked_at",
    "revocation_reason",
    "replaces_credential_id",
    "created_at",
    "record_digest"
  ],
  "title": "credential",
  "type": "object"
}
