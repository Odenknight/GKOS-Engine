{
  "$id": "session.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "absolute_expires_at": {
      "format": "date-time",
      "pattern": "^(?:19[7-9][0-9]|2[0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "type": "string"
    },
    "agent_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "auth_epoch": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "authority_generation_at_open": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "authority_instance_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "close_reason": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "closed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^(?:19[7-9][0-9]|2[0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "contract_version": {
      "const": "1.0.0-draft.1"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^(?:19[7-9][0-9]|2[0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "type": "string"
    },
    "credential_id": {
      "maxLength": 31,
      "minLength": 31,
      "pattern": "^gkc(?:0|1)_[a-z2-7]{26}$",
      "type": "string"
    },
    "idle_expires_at": {
      "format": "date-time",
      "pattern": "^(?:19[7-9][0-9]|2[0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "type": "string"
    },
    "last_activity_at": {
      "format": "date-time",
      "pattern": "^(?:19[7-9][0-9]|2[0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "type": "string"
    },
    "record_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "restore_epoch": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "session_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "closed",
        "expired",
        "stale"
      ]
    },
    "transport": {
      "enum": [
        "owner_cli",
        "native_stdio",
        "loopback_streamable_http",
        "private_authority",
        "effect_bridge",
        "migration_recovery"
      ]
    },
    "vault_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "vault_id",
    "authority_instance_id",
    "restore_epoch",
    "session_id",
    "agent_id",
    "auth_epoch",
    "credential_id",
    "transport",
    "authority_generation_at_open",
    "status",
    "created_at",
    "last_activity_at",
    "idle_expires_at",
    "absolute_expires_at",
    "closed_at",
    "close_reason",
    "record_digest"
  ],
  "title": "session",
  "type": "object"
}
