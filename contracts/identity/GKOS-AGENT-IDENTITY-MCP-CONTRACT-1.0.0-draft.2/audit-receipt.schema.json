          "type": "string"
        },
        "row_count": {
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "transport": {
          "enum": [
            "owner_cli",
            "native_stdio",
            "loopback_streamable_http",
            "private_authority",
            "effect_bridge",
            "migration_recovery"
