          "minimum": 1,
          "type": "integer"
        },
        "global_event_seq": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "last_sequence": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "occurred_at": {
          "format": "date-time",
          "pattern": "^(?:19[7-9][0-9]|2[0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
          "type": "string"
        },
        "ordered_rows_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "predecessor_event_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "record_type": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "restore_epoch": {
          "maximum": 9007199254740991,
          "minimum": 1,
