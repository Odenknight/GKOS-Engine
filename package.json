{
  "name": "gkos-engine",
  "version": "2.0.0",
  "description": "GKOS-Engine — canonical deterministic GKX engine with an optional, proposal-only DSPy intelligence sidecar; offline validation, projection, assessment, graph, and export remain authoritative.",
  "type": "module",
  "main": "./dist/gkos-engine.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/gkos-engine.mjs",
      "default": "./dist/gkos-engine.mjs"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.mjs",
      "default": "./dist/adapter.mjs"
    },
    "./gkx": {
      "types": "./dist/gkx.d.ts",
      "import": "./dist/gkx.mjs",
      "default": "./dist/gkx.mjs"
    },
    "./graphiti": {
      "types": "./dist/graphiti-adapter.d.ts",
      "import": "./dist/graphiti-adapter.mjs",
      "default": "./dist/graphiti-adapter.mjs"
    }
  },
  "bin": {
    "gkx": "bin/gkx.mjs"
  },
  "files": [
    "dist/",
    "!dist/gkos-agent-*",
    "!dist/sea-config.json",
    "!dist/sea-prep.blob",
    "bin/",
    "src/",
    "services/gkos-intelligence/"
  ],
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:intelligence": "python -m pytest services/gkos-intelligence",
    "pack:check": "node scripts/check-pack.mjs",
    "check:license": "node scripts/check-license.mjs"
  },
  "license": "Apache-2.0",
  "author": "OdenKnight",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Odenknight/GKOS-Engine.git"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6",
    "typescript": "5.9.3"
  }
}
