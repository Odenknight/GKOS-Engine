{
  "name": "gkos-engine",
  "version": "1.1.2",
  "description": "GKOS Engine — canonical deterministic OKF+ 2.3 engine with an optional, proposal-only DSPy intelligence sidecar; offline validation, projection, assessment, graph, and export remain authoritative.",
  "type": "module",
  "main": "./dist/kosmos-core.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/kosmos-core.mjs",
      "default": "./dist/kosmos-core.mjs"
    }
  },
  "bin": {
    "okf": "./bin/okf.mjs"
  },
  "files": [
    "dist/",
    "!dist/kosmos-agent-*",
    "!dist/sea-config.json",
    "!dist/sea-prep.blob",
    "bin/",
    "src/",
    "services/gkos-intelligence/"
  ],
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:intelligence": "python -m unittest discover -s services/gkos-intelligence/tests -v",
    "pack:check": "node scripts/check-pack.mjs"
  },
  "license": "MIT",
  "author": "OdenKnight",
  "repository": {
    "type": "git",
    "url": "https://github.com/Odenknight/GKOS-Engine.git"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6",
    "typescript": "5.9.3"
  }
}
